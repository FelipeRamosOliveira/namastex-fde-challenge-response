# Copie para .env e preencha. O .env NUNCA vai para o git.

# LLM gratuito (opcional): Groq principal, OpenRouter reserva. Chave gratuita em https://console.groq.com/keys
# Sem chave o agente roda só com regras e avisa no log e em GET /health.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Frase natural antes da resposta (sem números); false desliga
USAR_REDATOR=true

# Header x-api-key das rotas do vendedor (fila, operador) e de rastreio (trace, historico).
# Sem ela essas rotas respondem sempre 401 (gere um valor aleatório)
TRACE_API_KEY=

# Chave que o canal manda no header x-channel-key (obrigatória no Docker; gere um valor aleatório:
#   uv run python -c "import secrets;print(secrets.token_urlsafe(24))")
CHANNEL_API_KEY=

# Rodando fora do Docker (valores padrão já apontam para localhost)
# QUOTE_API_URL=http://localhost:8000
# REDIS_URL=redis://localhost:6379/0
# MCP_URL=http://localhost:8100/mcp

# Cifra o CEP guardado no checkpoint (obrigatória no Docker). Rotação: "nova,antiga" (gere com:
#   uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
VAULT_KEY=

# Omni (canal): segredo que o Omni manda no webhook, URL e chave da API do Omni
OMNI_PROVIDER_KEY=
OMNI_URL=
OMNI_API_KEY=
