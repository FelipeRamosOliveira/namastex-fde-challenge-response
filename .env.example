# Copie para .env e preencha. O .env NUNCA vai para o git.

# LLM gratuito (etapa 4): Groq principal, OpenRouter reserva
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Frase natural antes da resposta (sem números); false desliga
USAR_REDATOR=true

# Protege GET /v1/conversations/{id}/trace (gere um valor aleatório)
TRACE_API_KEY=

# Se definida, o canal (Omni) precisa mandar no header x-channel-key
CHANNEL_API_KEY=

# Rodando fora do Docker (valores padrão já apontam para localhost)
# QUOTE_API_URL=http://localhost:8000
# REDIS_URL=redis://localhost:6379/0
# MCP_URL=http://localhost:8100/mcp
